# Скопируйте этот файл в .env и впишите свои значения.
# Сервер перечитывает .env сам — перезапускать не нужно.

# Кто говорит: бесплатный токен Hugging Face (право Read).
# Перед этим примите условия на https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Пересказ и главы — достаточно одного из ключей.
# Gemini (есть бесплатный тариф): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Модель для пересказа по умолчанию: gemini-3.8-flash, gemini-3.1-pro-preview, gemini-3.5-flash-lite,
# claude-opus-5, claude-sonnet-5 или claude-haiku-4-5
# SUMMARY_MODEL=gemini-3.8-flash

# Если YouTube просит подтвердить, что вы не бот: браузер, где вы вошли в YouTube
# (firefox, chrome, edge). Cookies читаются только локально.
# YTDLP_COOKIES_FROM_BROWSER=firefox

# Адрес веб-интерфейса
# TRANSCRIPTOR_HOST=127.0.0.1
# TRANSCRIPTOR_PORT=8000

# Через сколько секунд простоя выгружать модели из видеопамяти
# TRANSCRIPTOR_IDLE_UNLOAD=600
