# Copy this file to .env and fill in your values (install.ps1 does the copy for you).
# The server re-reads .env by itself, no restart needed.
# Скопируйте файл в .env и впишите свои значения. Сервер перечитывает .env сам.

# Who is speaking: a free Hugging Face token (Read access).
# First accept the terms at https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Summaries, chapters and on-screen text: one of the keys is enough.
# Gemini (has a free tier; also needed for on-screen text): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Default summary model: gemini-3.8-flash, gemini-3.1-pro-preview, gemini-3.5-flash-lite,
# claude-opus-5, claude-sonnet-5 or claude-haiku-4-5
# SUMMARY_MODEL=gemini-3.8-flash

# If YouTube asks to confirm you are not a bot: the browser where you are signed in to YouTube
# (firefox, chrome, edge). Cookies are read locally only.
# YTDLP_COOKIES_FROM_BROWSER=firefox

# Language of server messages before you pick one in the web interface: en or ru
# TRANSCRIPTOR_LANG=en

# Web interface address
# TRANSCRIPTOR_HOST=127.0.0.1
# TRANSCRIPTOR_PORT=8000

# Unload the models from GPU memory after this many idle seconds
# TRANSCRIPTOR_IDLE_UNLOAD=600
